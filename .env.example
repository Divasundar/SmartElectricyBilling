# ============================================================
# Smart Electricity Billing System - Local Environment Config
# ============================================================
# Copy this file to .env and configure your MySQL credentials.
# The .env file is excluded from Git version control.

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_billing
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Ports (Optional overrides)
SERVER_PORT=8080
FRONTEND_PORT=5173
